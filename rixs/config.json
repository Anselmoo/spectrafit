{
  "fitting": {
    "description": {
      "project_name": "SpectraFit Project"
    },
    "parameters": {
      "minimizer": {
        "nan_policy": "propagate",
        "calc_covar": true
      },
      "optimizer": {
        "max_nfev": 1000,
        "method": "leastsq"
      }
    },
    "peaks": {
      "1": {
        "gaussian": {
          "amplitude": {
            "min": 0,
            "max": 2,
            "vary": true,
            "value": 1.0
          },
          "center": {
            "min": -2,
            "max": 2,
            "vary": true,
            "value": 0.0
          },
          "fwhmg": {
            "min": 0.02,
            "max": 0.5,
            "vary": true,
            "value": 0.1
          }
        }
      }
    }
  }
}
